# ─── Agent meta-configuration ───────────────────────────────────────────────
# Lives in the separate seq-sklearn-meta repo, mounted at .meta/ via symlinks.
# Don't commit any of it from this repo. Run `bash .meta/bootstrap.sh` on a
# fresh clone to set up the symlinks.
.meta
CLAUDE.md
.claude
GEMINI.md
.gemini
.geminiignore

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# Sphinx build output (Phase 12).
docs/_build/
# sphinx-gallery generated trees.
docs/examples_gallery/
docs/sg_execution_times.rst
# autosummary-generated stubs (regenerated by `autosummary_generate`).
docs/api/generated/

.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.pyright_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Virtual environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── ML artifacts ───────────────────────────────────────────────────────────
checkpoints/
runs/
wandb/
mlruns/
lightning_logs/
*.pt
*.pth
*.ckpt
*.safetensors
*.pkl

# Phase 9 snapshot test fixtures are committed under tests/_snapshots/ per
# N1; the SNAPSHOT_REVIEWED: commit-message gate guards updates.
!tests/_snapshots/**
!tests/_snapshots/.gitkeep

# ─── Data ───────────────────────────────────────────────────────────────────
/data/
/datasets/

# ─── Local config / secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Editor / OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Benchmark data caches (large; downloaded on demand)
.cache/
coverage.json
